NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser, never referenced with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Supavisor transaction pooler — used by Supabase CLI / migrations only, never client-side
DATABASE_URL=

# ElevenLabs voice (server-side only — never exposed to the browser).
# Rotate this key in the ElevenLabs dashboard if it has ever been shared.
ELEVENLABS_API_KEY=

# Single voice for the entire voice assistant — "Priyanka Sogam" (Hindi,
# professional). NOTE: professional/library voices require a PAID ElevenLabs
# plan; on the free tier this returns HTTP 402 and the assistant falls back to
# the browser voice. Upgrade the plan and this voice works with no code change.
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
# Free-plan fallback that actually works via API (premade): EXAVITQu4vr4xnSDxMaL (Sarah)

# OpenAI (server-side only). Rotate this key — it has been shared in chat.
